{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "db:setup": "node scripts/ensure-env.mjs && prisma db push && prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "dev": "npm run db:setup && tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@prisma/client": "^5.21.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.1",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.10.2",
    "prisma": "^5.21.0",
    "tsx": "^4.19.1",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
